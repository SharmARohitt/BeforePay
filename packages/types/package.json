{
  "name": "@beforepay/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for BeforePay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsc --watch --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
