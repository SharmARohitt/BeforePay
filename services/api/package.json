{
  "name": "@beforepay/api",
  "version": "0.1.0",
  "description": "BeforePay API Service",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "migrate": "node --import tsx/esm ./scripts/migrate.ts",
    "seed": "node --import tsx/esm ./scripts/seed.ts",
    "reset": "node --import tsx/esm ./scripts/reset.ts"
  },
  "dependencies": {
    "@beforepay/database": "workspace:*",
    "@beforepay/types": "workspace:*",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "^11.1.0",
    "axios": "^1.6.0",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.25.0",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
